# Backend Environment Configuration
PROJECT_NAME="AI Voice Form Assistant"
ENVIRONMENT="development"  # Options: development, testing, production
DATABASE_URL="sqlite:///./app.db"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:3000", "http://127.0.0.1:3000"]

# AI Configuration (Groq is the primary cloud AI provider)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
AI_PROVIDER="groq"
AI_DEMO_MODE=false
ALLOW_PRODUCTION_DEMO_MODE=false

# Speech-to-Text (STT) Provider Configuration
# Supported providers: "groq" (default), "sarvam"
STT_PROVIDER="groq"

# Groq Whisper STT Options
# Supported models: "whisper-large-v3-turbo" (fast, cost-effective), "whisper-large-v3" (maximum accuracy)
GROQ_STT_MODEL="whisper-large-v3-turbo"
# Leave empty for automatic multilingual detection (recommended for mixed Tamil-English), or set to "ta" or "en"
GROQ_STT_LANGUAGE=""
GROQ_STT_TEMPERATURE=0.0
GROQ_STT_PROMPT="English, Tamil, Tanglish form details. Names, email, phone numbers, department names."

# Optional Sarvam AI Indic STT Configuration (only required if STT_PROVIDER="sarvam")
# Get your API key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=""
SARVAM_STT_MODEL="saaras:v4"  # Options: "saaras:v4", "saaras:v3"
SARVAM_STT_MODE="codemix"    # Options: "codemix", "transcribe", "verbatim", "translate", "translit"
SARVAM_STT_LANGUAGE_CODE="unknown" # Options: "unknown" (auto), "ta-IN", "en-IN"

# Legacy AI migration support (optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Security & JWT Configuration
# Required in production: minimum 32 random characters (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SEED_DEMO_USER=false

# One-Time Super Admin Administrative Bootstrap (Optional)
# To provision the initial Super Administrator, generate a random 32+ character key:
# openssl rand -hex 32
BOOTSTRAP_SECRET_KEY=""
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
BOOTSTRAP_SUPER_ADMIN_PASSWORD=""
BOOTSTRAP_SUPER_ADMIN_NAME="Super Administrator"

# Server Configuration
HOST="127.0.0.1"
PORT=8090
LOG_LEVEL="INFO"

