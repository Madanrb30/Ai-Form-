# Backend Environment Configuration
PROJECT_NAME="AI Voice Form Assistant"
ENVIRONMENT="development"  # Options: development, testing, production
DATABASE_URL="sqlite:///./app.db"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:3000", "http://127.0.0.1:3000"]

# AI Configuration (Groq is the primary cloud AI provider)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
AI_PROVIDER="groq"
AI_DEMO_MODE=false
ALLOW_PRODUCTION_DEMO_MODE=false

# Legacy AI migration support (optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Security & JWT Configuration
# Required in production: minimum 32 random characters (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SEED_DEMO_USER=false

# Server Configuration
HOST="127.0.0.1"
PORT=8090
LOG_LEVEL="INFO"

