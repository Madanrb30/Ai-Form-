# Backend Environment Configuration
PROJECT_NAME="AI Voice Form Assistant"
DATABASE_URL="sqlite:///./app.db"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:3000", "http://127.0.0.1:3000"]

# AI Configuration (Groq is the primary provider)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
AI_PROVIDER="groq"
AI_DEMO_MODE=false

# Legacy AI migration support (optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Security & JWT
JWT_SECRET_KEY="replace_with_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Server Configuration
HOST="127.0.0.1"
PORT=8090
LOG_LEVEL="INFO"
