# ============================================================
# AI VOICE FORM ASSISTANT - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

PROJECT_NAME="AI Voice Form Assistant"
ENVIRONMENT="development"

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

DATABASE_URL="sqlite:///./app.db"

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------
# GROQ AI CONFIGURATION
# ------------------------------------------------------------

# Get your API key from https://console.groq.com/keys
GROQ_API_KEY="YOUR_GROQ_API_KEY"

GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_FALLBACK_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"

AI_PROVIDER="groq"
AI_DEMO_MODE=false
ALLOW_PRODUCTION_DEMO_MODE=false

# ------------------------------------------------------------
# SPEECH-TO-TEXT PROVIDER
# ------------------------------------------------------------

# Supported providers in your configuration: sarvam (primary default), groq
STT_PROVIDER="sarvam"

# ------------------------------------------------------------
# GROQ WHISPER SPEECH-TO-TEXT
# ------------------------------------------------------------

# Options: whisper-large-v3-turbo, whisper-large-v3
GROQ_STT_MODEL="whisper-large-v3-turbo"

# Empty means automatic language detection
GROQ_STT_LANGUAGE=""

GROQ_STT_TEMPERATURE=0.0

GROQ_STT_PROMPT="English, Tamil, Tanglish form details. Names, email, phone numbers, department names."

# ------------------------------------------------------------
# SARVAM SPEECH-TO-TEXT
# ------------------------------------------------------------

# Get your API key from https://dashboard.sarvam.ai
SARVAM_API_KEY="YOUR_SARVAM_API_KEY"

SARVAM_STT_MODEL="saaras:v4"
SARVAM_STT_MODE="codemix"
SARVAM_STT_LANGUAGE_CODE="unknown"

# ------------------------------------------------------------
# LEGACY GEMINI CONFIGURATION
# ------------------------------------------------------------

# Leave empty if Gemini is not used
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------

# Generate a secure value using:
# python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET"

JWT_ALGORITHM="HS256"

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Keep false unless demo-user seeding is intentionally required
SEED_DEMO_USER=false

# ------------------------------------------------------------
# SUPER ADMIN BOOTSTRAP
# ------------------------------------------------------------

# Configure these only when provisioning the initial Super Admin.
# Generate a random bootstrap key using:
# python -c "import secrets; print(secrets.token_hex(32))"

BOOTSTRAP_SECRET_KEY=""
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
BOOTSTRAP_SUPER_ADMIN_PASSWORD=""
BOOTSTRAP_SUPER_ADMIN_NAME="Super Administrator"

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------

HOST="127.0.0.1"
PORT=8090

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

LOG_LEVEL="INFO"